rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        request.auth.token != null && 
        'email' in request.auth.token && 
        request.auth.token.email != null && (
          request.auth.token.email.lower() == "adminjaf@gmail.com" ||
          request.auth.token.email.lower() == "davemon080@gmail.com" ||
          request.auth.token.email.lower() == "daveimagodei@gmail.com" ||
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
           get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == "admin")
        );
    }

    // --- Global Administrator Privilege Grant ---
    // Verified administrators have unrestricted CRUD access to all collections and documents
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Specific Collection Rules for Regular Users / Guests ---

    match /products/{productId} {
      allow read: if true;
    }

    match /zones/{zoneId} {
      allow read: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && 
        request.auth.token != null && 
        'email' in request.auth.token && 
        (resource.data.customer.email == request.auth.token.email || resource.data.customer.email.lower() == request.auth.token.email.lower());
      allow list: if isSignedIn() && 
        request.auth.token != null && 
        'email' in request.auth.token && 
        (resource.data.customer.email == request.auth.token.email || resource.data.customer.email.lower() == request.auth.token.email.lower());
      allow create: if true; // Support guest checkout
    }

    match /settings/{settingId} {
      allow read: if true;
    }

    match /users/{emailKey} {
      allow read: if isSignedIn() && 
        request.auth.token != null && 
        'email' in request.auth.token && 
        (request.auth.token.email == emailKey || request.auth.token.email.lower() == emailKey.lower());
      allow create: if true; // New profile registration
      allow update: if isSignedIn() && 
        request.auth.token != null && 
        'email' in request.auth.token && 
        (request.auth.token.email == emailKey || request.auth.token.email.lower() == emailKey.lower()) && 
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role);
    }

    match /messages/{messageId} {
      allow create: if true; // Allow guests to submit contact forms
    }

    match /traffic_events/{eventId} {
      allow create: if true; // Allow anonymous traffic tracking
    }

    match /ads/{adId} {
      allow read: if true;
      allow update: if true; // Allow click events to update ad stats
    }
  }
}
