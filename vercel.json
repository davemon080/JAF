{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm run build:vercel",
  "functions": {
    "api/product.ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([fF]acebookexternalhit|[tT]witterbot|[wW]hats[aA]pp|[tT]elegram[bB]ot|[sS]lackbot|[dD]iscord|[lL]inkedin[bB]ot|[eE]mbedly|[gG]oogle[bB]ot|[bB]ing[bB]ot|[aA]pple[bB]ot).*"
        }
      ],
      "destination": "/api/product?slug=:slug"
    },
    {
      "source": "/product/:slug/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([fF]acebookexternalhit|[tT]witterbot|[wW]hats[aA]pp|[tT]elegram[bB]ot|[sS]lackbot|[dD]iscord|[lL]inkedin[bB]ot|[eE]mbedly|[gG]oogle[bB]ot|[bB]ing[bB]ot|[aA]pple[bB]ot).*"
        }
      ],
      "destination": "/api/product?slug=:slug"
    }
  ]
}
