{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm run build:vercel",
  "functions": {
    "api/product.ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/product/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(facebookexternalhit|twitterbot|whatsapp|telegrambot|slackbot|discord|linkedinbot|embedly|googlebot|bingbot|applebot)"
        }
      ],
      "destination": "/api/product?slug=:slug"
    },
    {
      "source": "/product/:slug/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(facebookexternalhit|twitterbot|whatsapp|telegrambot|slackbot|discord|linkedinbot|embedly|googlebot|bingbot|applebot)"
        }
      ],
      "destination": "/api/product?slug=:slug"
    }
  ]
}
